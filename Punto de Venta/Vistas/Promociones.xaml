<Window x:Class="Punto_de_Venta.Promociones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Imagenes/Logo.ico"
        Title="Promociones"
        Width="980" Height="640"
        MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="SystemGreen" Color="#34C759" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="WinCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBackground}" 
            BorderBrush="{DynamicResource ThemeBorder}" 
            BorderThickness="1" 
            CornerRadius="18" 
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="ModernTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Imagenes/Logo.ico" Width="16" Height="16" Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                <TextBlock Grid.Column="1" Text="Promociones y Paquetes" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Button Grid.Column="2" Style="{StaticResource WinCaptionButtonStyle}" Click="BtnClose_Click" Margin="0,0,8,0">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource ThemeMutedForeground}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Cuerpo principal -->
            <Grid Grid.Row="1" Margin="22,8,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: Lista de promociones registradas -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="PromocionesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              RowHeight="46"
                              SelectionMode="Single"
                              SelectionChanged="PromocionesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="2*" />
                            <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="1*" />
                            <DataGridCheckBoxColumn Header="ACTIVA" Binding="{Binding Activa}" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Derecha: Formulario de creación rápida -->
                <!-- Formulario dinámico de creación -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Nueva Promoción" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,14" />

                        <TextBlock Text="Nombre descriptivo" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                        <TextBox x:Name="NombrePromoBox" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" Margin="0,0,0,12" />

                        <TextBlock Text="Tipo de Promoción" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                        <ComboBox x:Name="TipoPromoCombo" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectionChanged="TipoPromoCombo_SelectionChanged">
                            <ComboBoxItem Content="Volumen (Ej: 3 por $45)" IsSelected="True" Tag="Volumen" />
                            <ComboBoxItem Content="Combo (Producto A + B)" Tag="Combo" />
                            <ComboBoxItem Content="Segunda pieza con Descuento" Tag="PorcentajeSegundo" />
                        </ComboBox>

                        <!-- PRODUCTO 1 (Siempre visible) -->
                        <TextBlock x:Name="LabelProd1" Text="ID Producto Principal" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                        <TextBox x:Name="ProdId1Box" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" Margin="0,0,0,12" />

                        <!-- PRODUCTO 2 (Solo visible cuando es Combo) -->
                        <StackPanel x:Name="PanelProducto2" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="ID Segundo Producto (B)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                            <TextBox x:Name="ProdId2Box" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" />
                        </StackPanel>

                        <!-- CAMPOS PARA VOLUMEN (Cantidad mínima + Precio) -->
                        <Grid x:Name="PanelVolumen" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad Mínima" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="CantidadMinBox" Text="3" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Precio Especial ($)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="PrecioEspecialBox" Text="0.00" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" />
                            </StackPanel>
                        </Grid>

                        <!-- CAMPOS PARA COMBO (Precio total del combo) -->
                        <StackPanel x:Name="PanelPrecioCombo" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Precio Total del Combo ($)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                            <TextBox x:Name="PrecioComboTotalBox" Text="0.00" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" />
                        </StackPanel>

                        <!-- CAMPOS PARA PORCENTAJE (Ej. 50%) -->
                        <StackPanel x:Name="PanelPorcentaje" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="% Descuento en 2da pieza (ej: 50)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                            <TextBox x:Name="PorcentajeDescuentoBox" Text="50" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" />
                        </StackPanel>

                        <Button Content="Guardar Promoción" Height="44" Background="{DynamicResource ThemeAccent}" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,10,0,0" Click="GuardarPromo_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>