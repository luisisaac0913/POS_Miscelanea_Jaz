<Application x:Class="Punto_de_Venta.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Punto_de_Venta"
             ShutdownMode="OnExplicitShutdown"
             StartupUri="Vistas/MainWindow.xaml">
    <Application.Resources>
        <!-- Tokens Apple Light Iniciales -->
        <!-- ================= SCROLLBAR MINIMALISTA FLUIDA ================= -->
        <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                        Background="#408E8E93" 
                        CornerRadius="4" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#808E8E93" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar General sin flechas estorbosas -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Margin="1,0">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbs}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="false" Margin="0,1">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbs}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="ThemeWindowBackground" Color="#F2F2F7" />
        <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeInputBackground" Color="#F2F2F7" />
        <SolidColorBrush x:Key="ThemeTextForeground" Color="#1C1C1E" />
        <SolidColorBrush x:Key="ThemeMutedForeground" Color="#8E8E93" />
        <SolidColorBrush x:Key="ThemeAccent" Color="#007AFF" />
        <SolidColorBrush x:Key="ThemeButtonBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeBorder" Color="#E5E5EA" />
        <SolidColorBrush x:Key="ThemePlaceholder" Color="#8E8E93" />
    </Application.Resources>
</Application>