<Window x:Class="Punto_de_Venta.Ventas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Imagenes/Logo.ico"
        Width="1280" Height="740"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Sombras estilo tarjeta iOS -->
        <DropShadowEffect x:Key="AppleCardShadow" BlurRadius="24" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
        <DropShadowEffect x:Key="AppleButtonShadow" BlurRadius="12" ShadowDepth="3" Direction="270" Color="#007AFF" Opacity="0.22" />

        <!-- ■ INICIO: Estilos modernos redondeados para los botones de ventana -->
        <Style x:Key="WinCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="{DynamicResource ThemeBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="#C40E1E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ■ FIN: Estilos modernos redondeados para los botones de ventana -->

        <!-- Tarjetas principales -->
        <Style x:Key="AppleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Effect" Value="{StaticResource AppleCardShadow}" />
        </Style>

        <!-- Botones Segmentados de Periodo (Estilo iOS / Gráficas) -->
        <Style x:Key="PeriodSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Píldoras informativas de estadísticas -->
        <Style x:Key="AppleStatPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <!-- Botón Secundario iOS (Estilo Cápsula) -->
        <Style x:Key="ApplePillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Peligro / Devolución iOS -->
        <Style x:Key="AppleDangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#FECACA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#FCA5A5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Principal Primario iOS (Cierre de Caja) -->
        <Style x:Key="ApplePrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Effect" Value="{StaticResource AppleButtonShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{DynamicResource ThemeBorder}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ■ INICIO: Contenedor con esquinas redondeadas y fondo dinámico -->
    <Border Background="{DynamicResource ThemeWindowBackground}" 
            BorderBrush="{DynamicResource ThemeBorder}" 
            BorderThickness="1" 
            CornerRadius="18" 
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <!-- ■ Fila 0: Barra superior moderna -->
                <RowDefinition Height="*" />
                <!-- ■ Fila 1: Cuerpo de la ventana -->
            </Grid.RowDefinitions>

            <!-- ■ INICIO: Barra de título con el texto 'Ventas' en el centro -->
            <Grid Grid.Row="0" 
                  Background="Transparent" 
                  MouseLeftButtonDown="ModernTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icono de la ventana -->
                <Image Grid.Column="0" 
                       Source="/Imagenes/Logo.ico" 
                       Width="16" Height="16" 
                       Margin="16,0,0,0" 
                       VerticalAlignment="Center" 
                       Opacity="0.75" />

                <!-- ■ Título 'Ventas' centrado exactamente en la barra -->
                <TextBlock Grid.Column="1" 
                           Text="Ventas" 
                           FontFamily="Segoe UI Variable, Segoe UI, -apple-system" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextForeground}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           IsHitTestVisible="False" />

                <!-- ■ Botones modernos a la derecha -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="0,0,6,0">

                    <!-- Minimizar -->
                    <Button Style="{StaticResource WinCaptionButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimizar">
                        <Path Data="M 0,0 L 10,0" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.5" 
                              StrokeStartLineCap="Round" 
                              StrokeEndLineCap="Round" 
                              VerticalAlignment="Center" />
                    </Button>

                    <!-- Maximizar / Restaurar -->
                    <Button Style="{StaticResource WinCaptionButtonStyle}" Click="BtnMaximize_Click" ToolTip="Maximizar">
                        <Border Width="10" Height="10" 
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                BorderThickness="1.5" 
                                CornerRadius="2.5" />
                    </Button>

                    <!-- Cerrar -->
                    <Button Style="{StaticResource WinCaptionCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Cerrar">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.5" 
                              StrokeStartLineCap="Round" 
                              StrokeEndLineCap="Round" 
                              VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
            <!-- ■ FIN: Barra de título moderna -->

            <!-- ■ INICIO: Contenido de la ventana dentro de la Fila 1 -->
            <Grid Grid.Row="1" Margin="32,10,32,24">
                <Grid.RowDefinitions>
                    <!-- 0: Encabezado + Barra de Segmentos -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Barra de Búsqueda -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Tabla de Ventas -->
                    <RowDefinition Height="*" />
                    <!-- 3: Estadísticas y Botones Inferiores -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Source="/Imagenes/Logo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="450" Opacity="0.12" IsHitTestVisible="False" Panel.ZIndex="0" />

                <!-- 0. Encabezado iOS con Filtros de Periodo -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ■ CAMBIO: Se retiró el TextBlock grande 'Ventas' porque ya se ubica en el centro de la barra superior -->

                    <!-- Controles a la derecha: Filtros Segmentados + Reloj -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cápsula Segmentada de Selección de Tiempo -->
                        <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnPeriodoDia" Content="Día" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Dia" />
                                <Button x:Name="BtnPeriodoSemana" Content="Semana" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Semana" />
                                <Button x:Name="BtnPeriodoMes" Content="Mes" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Mes" />
                                <Button x:Name="BtnPeriodoCustom" Content="Personalizado" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Custom" />
                            </StackPanel>
                        </Border>

                        <!-- Panel de Fechas (Visible solo si se pulsa Personalizado) -->
                        <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <DatePicker x:Name="DatePickerDesde" Height="36" Width="120" VerticalContentAlignment="Center" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                            <TextBlock Text="al" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                            <DatePicker x:Name="DatePickerHasta" Height="36" Width="120" VerticalContentAlignment="Center" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                        </StackPanel>

                        <!-- Reloj iOS -->
                        <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Text="6:08 PM" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 1. Barra de Búsqueda estilo iOS SearchBar -->
                <Border Grid.Row="1" Height="44" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" Foreground="{DynamicResource ThemeTextForeground}" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Buscar venta por ID, fecha o productos" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Buscar venta por ID, fecha o productos..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Tabla DataGrid iOS Container (Ordenada descendentemente) -->
                <Border Grid.Row="2" Style="{StaticResource AppleCardStyle}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="SalesGrid" ItemsSource="{Binding SalesView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ThemeBorder}" BorderThickness="0" Background="Transparent" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="SalesGrid_SelectionChanged" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" RowHeight="54" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
                                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="12,12" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                        <Setter Property="Background" Value="#F0FDF4" />
                                        <Setter Property="Foreground" Value="#166534" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Cancelada">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                        <Setter Property="Foreground" Value="#991B1B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Fiado">
                                        <Setter Property="Background" Value="#FFFBEB" />
                                        <Setter Property="Foreground" Value="#92400E" />
                                    </DataTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E5F1FF" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="ESTADO" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadge" 
                    CornerRadius="8" 
                    Padding="10,4" 
                    HorizontalAlignment="Center" 
                    BorderThickness="1"
                    Background="#15007AFF" 
                    BorderBrush="#30007AFF">
                                            <TextBlock x:Name="StatusText" 
                           Text="{Binding Estado}" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="#007AFF" 
                           HorizontalAlignment="Center" />
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <!-- 1. Venta Cerrada (Verde Esmeralda) -->
                                            <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#152ECC71" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#402ECC71" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#2ECC71" />
                                                <Setter TargetName="StatusText" Property="Text" Value="Cerrada" />
                                            </DataTrigger>

                                            <!-- 2. Venta Abierta / En Turno (Azul Apple) -->
                                            <DataTrigger Binding="{Binding Estado}" Value="Abierta">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#15007AFF" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#40007AFF" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#007AFF" />
                                                <Setter TargetName="StatusText" Property="Text" Value="Abierta" />
                                            </DataTrigger>

                                            <!-- 3. Fiado o Pendiente (Ámbar / Naranja) -->
                                            <DataTrigger Binding="{Binding Estado}" Value="Fiado">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#15F39C12" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#40F39C12" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#F39C12" />
                                                <Setter TargetName="StatusText" Property="Text" Value="Fiado" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MÉTODO" Binding="{Binding MetodoPago}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PRODUCTOS" Binding="{Binding ProductosResumen}" Width="2.1*" />
                            <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadTotal}" Width="0.65*" />
                            <DataGridTextColumn Header="PAGO CON" Binding="{Binding PagoCon, StringFormat={}{0:C2}}" Width="0.8*" />
                            <DataGridTextColumn Header="CAMBIO" Binding="{Binding Cambio, StringFormat={}{0:C2}}" Width="0.8*" />
                            <DataGridTextColumn Header="FECHA" Binding="{Binding FechaHora, StringFormat={}{0:dd/MM/yyyy hh:mm tt}}" Width="1.35*" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="0.85*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 3. Barra Inferior iOS: Métricas Dinámicas y Botones -->
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: Cuadrícula de Métricas Recalculadas -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Fila 1: Botón Detalles + Ingresos + Gastos -->
                        <Button Grid.Row="0" Grid.Column="0" Content="Ver Detalles de Venta" Style="{StaticResource ApplePillButtonStyle}" MinWidth="200" Click="ViewDetailsButton_Click" />

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource AppleStatPillStyle}" MinWidth="190">
                            <TextBlock x:Name="TotalSalesTodayText" Text="Total de ventas: $0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource AppleStatPillStyle}" MinWidth="170">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Gastos: " FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" />
                                <TextBlock x:Name="MetricGastosText" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#EF4444" />
                            </StackPanel>
                        </Border>

                        <!-- Fila 2: Ganancia Neta + Productos Vendidos + Balance del Periodo -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource AppleStatPillStyle}" MinWidth="200">
                            <TextBlock x:Name="TotalProfitText" Text="Ganancia: $0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource AppleStatPillStyle}" MinWidth="190">
                            <TextBlock x:Name="TotalProductsSoldText" Text="Prod. vendidos: 0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource AppleStatPillStyle}" MinWidth="170">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Balance: " FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" />
                                <TextBlock x:Name="MetricBalanceText" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Derecha: Botones de Acción (DEVOLUCIÓN y CIERRE DE CAJA) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ReturnButton" Content="DEVOLUCIÓN" Style="{StaticResource AppleDangerButtonStyle}" MinWidth="140" Margin="0,0,12,0" IsEnabled="False" Click="ReturnButton_Click" />
                        <Button Content="CIERRE DE CAJA" Style="{StaticResource ApplePrimaryActionButtonStyle}" MinWidth="180" Click="CashCloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- ■ FIN: Contenido de la ventana -->
        </Grid>
    </Border>
</Window>