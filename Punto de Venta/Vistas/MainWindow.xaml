<Window x:Class="Punto_de_Venta.MainWindow"
        PreviewKeyDown="Window_PreviewKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Imagenes/Logo.ico"
        Width="1280" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Sombras suaves estilo iOS/iPadOS -->
        <DropShadowEffect x:Key="AppleAppIconShadow" BlurRadius="22" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.08" />
        <DropShadowEffect x:Key="AppleModalShadow" BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.25" />

        <!-- Estilos de barra de título -->
        <Style x:Key="WinCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="{DynamicResource ThemeBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderBtn" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderBtn" Property="Background" Value="#C40E1E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Píldora Promociones (Estilo Header Widget) -->
        <Style x:Key="HeaderPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource AppleAppIconShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjetas de App tipo Cuadrícula iOS -->
        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="26"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource AppleAppIconShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportModalCardStyle" TargetType="Button">
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ExportBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExportBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ExportBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor principal con bordes redondeados y fondo dinámico -->
    <Border Background="{DynamicResource ThemeWindowBackground}" 
            BorderBrush="{DynamicResource ThemeBorder}" 
            BorderThickness="1" 
            CornerRadius="18" 
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0" 
                  Background="Transparent" 
                  MouseLeftButtonDown="ModernTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="/Imagenes/Logo.ico" 
                       Width="16" Height="16" 
                       Margin="16,0,0,0" 
                       VerticalAlignment="Center" 
                       Opacity="0.75" />

                <TextBlock Grid.Column="1" 
                           Text="Miscelanea Jaz" 
                           FontFamily="Segoe UI Variable, Segoe UI, -apple-system" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextForeground}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           IsHitTestVisible="False" />

                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="0,0,6,0">

                    <Button Style="{StaticResource WinCaptionButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimizar">
                        <Path Data="M 0,0 L 10,0" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.5" 
                              StrokeStartLineCap="Round" 
                              StrokeEndLineCap="Round" 
                              VerticalAlignment="Center" />
                    </Button>

                    <Button Style="{StaticResource WinCaptionButtonStyle}" Click="BtnMaximize_Click" ToolTip="Maximizar">
                        <Border Width="10" Height="10" 
                                BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                BorderThickness="1.5" 
                                CornerRadius="2.5" />
                    </Button>

                    <Button Style="{StaticResource WinCaptionCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Cerrar">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="1.5" 
                              StrokeStartLineCap="Round" 
                              StrokeEndLineCap="Round" 
                              VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Contenido principal -->
            <Grid Grid.Row="1" Margin="36,10,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Encabezado iOS -->
                <Grid Grid.Row="0" Margin="4,0,4,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Miscelanea"
                                   FontFamily="Segoe UI Variable, Segoe UI, -apple-system"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextForeground}" />
                    </StackPanel>

                    <!-- Zona Derecha: Botón Promociones + Cápsula de Reloj -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- ■ NUEVO: Botón Promociones ubicado en la zona marcada -->
                        <Button x:Name="BtnPromociones"
                                Style="{StaticResource HeaderPillButtonStyle}"
                                Height="56"
                                Margin="0,0,14,0"
                                Click="Promociones_Click"
                                ToolTip="Gestionar ofertas y paquetes automáticos">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏷️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Promociones" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" />
                                    <TextBlock Text="Ofertas y Combos" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Cápsula de reloj y fecha estilo Widget de iOS -->
                        <Border Background="{DynamicResource ThemeSurfaceBackground}"
                                BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="16,8"
                                Height="56"
                                VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="ClockText"
                                           Text="00:00"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeTextForeground}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="DateText"
                                           Text=""
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource ThemeMutedForeground}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. Rejilla principal de accesos directos -->
                <UniformGrid x:Name="ShortcutGrid"
                             Grid.Row="1"
                             Rows="2"
                             Columns="4"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">

                    <!-- Cobro -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Cobro" Click="Cobro_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 9,15 L 18,15 L 27,60 L 76,60 L 86,30 L 24,30"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M 28,40 L 81,40 M 32,51 L 78,51"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="34" Canvas.Top="68" Width="8" Height="8" Fill="{DynamicResource ThemeSurfaceBackground}" Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" />
                                    <Ellipse Canvas.Left="69" Canvas.Top="68" Width="8" Height="8" Fill="{DynamicResource ThemeSurfaceBackground}" Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" />
                                    <TextBlock Canvas.Left="39" Canvas.Top="4" Text="$" FontFamily="Segoe UI Variable, Segoe UI" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Cobro" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Ventas -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Ventas" Click="Ventas_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 25,8 L 61,8 L 77,24 L 77,82 L 25,82 Z M 61,8 L 61,24 L 77,24"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="4" StrokeLineJoin="Round" />
                                    <TextBlock Canvas.Left="39" Canvas.Top="28" Text="$" FontFamily="Segoe UI Variable, Segoe UI" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                                    <Path Data="M 37,62 L 65,62 M 37,70 L 65,70"
                                          Stroke="{DynamicResource ThemeMutedForeground}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Ventas" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Inventario -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Lista Prod" Click="Inventario_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 23,16 L 34,16 L 37,10 L 60,10 L 63,16 L 75,16 L 75,73 L 23,73 Z"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="4" StrokeLineJoin="Round" />
                                    <Path Data="M 33,29 L 38,29 L 38,34 L 33,34 Z M 46,31 L 65,31 M 33,42 L 38,42 L 38,47 L 33,47 Z M 46,44 L 62,44 M 33,55 L 38,55 L 38,60 L 33,60 Z M 46,57 L 58,57"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" StrokeLineJoin="Round" />
                                    <Path Data="M 57,64 L 77,39 L 83,44 L 63,69 L 55,72 Z M 74,42 L 80,47"
                                          Stroke="{DynamicResource ThemeAccent}" StrokeThickness="4" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Inventario" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Subir List -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Subir List" Click="BtnSubirLista_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 28,10 L 57,10 L 74,27 L 74,80 L 28,80 Z M 57,10 L 57,27 L 74,27"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="4" StrokeLineJoin="Round" />
                                    <Path Data="M 51,68 L 51,39 M 40,50 L 51,39 L 62,50 M 40,68 L 62,68"
                                          Stroke="{DynamicResource ThemeAccent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Subir List" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Graficas -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Graficas" Click="Graficas_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 12,68 L 88,68 L 83,75 L 17,75 Z M 21,16 L 79,16 L 79,64 L 21,64 Z"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3.5" StrokeLineJoin="Round" />
                                    <Path Data="M 44,26 A 15,15 0 1 0 44,56 L 44,41 Z M 47,26 A 15,15 0 0 1 61,40 L 47,40 Z"
                                          Stroke="{DynamicResource ThemeAccent}" StrokeThickness="3" StrokeLineJoin="Round" />
                                    <Path Data="M 68,55 L 68,46 L 73,46 L 73,55 Z M 76,55 L 76,37 L 81,37 L 81,55 Z"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                    <Path Data="M 65,30 L 70,25 L 74,29 L 81,22"
                                          Stroke="{DynamicResource ThemeMutedForeground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Graficas" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Configuracion -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Configuracion" Click="Configuracion_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 45,12 L 55,12 L 57,21 A 30,30 0 0 1 64,25 L 72,20 L 79,27 L 74,35 A 30,30 0 0 1 78,42 L 87,44 L 87,54 L 78,56 A 30,30 0 0 1 74,63 L 79,71 L 72,78 L 64,73 A 30,30 0 0 1 57,77 L 55,86 L 45,86 L 43,77 A 30,30 0 0 1 36,73 L 28,78 L 21,71 L 26,63 A 30,30 0 0 1 22,56 L 13,54 L 13,44 L 22,42 A 30,30 0 0 1 26,35 L 21,27 L 28,20 L 36,25 A 30,30 0 0 1 43,21 Z"
                                          Stroke="{DynamicResource ThemeAccent}" StrokeThickness="6.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Ellipse Canvas.Left="38" Canvas.Top="37" Width="24" Height="24"
                                             Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="6" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Configuracion" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Prestamo -->
                    <Button Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Prestamo" Click="Prestamos_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 37,55 C 34,47 40,37 45,31 L 44,20 L 57,20 L 56,31 C 62,37 67,46 63,55 L 59,62 L 40,62 Z"
                                          Fill="{DynamicResource ThemeTextForeground}" Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" StrokeLineJoin="Round" />
                                    <Path Data="M 47,30 L 47,19 L 54,19 L 54,30 M 46,42 C 50,38 57,41 56,46 C 55,50 48,50 48,54 C 48,58 55,59 58,55 M 52,37 L 52,60"
                                          Stroke="{DynamicResource ThemeSurfaceBackground}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M 24,64 L 35,64 L 43,58 L 60,58 C 66,58 66,65 60,67 L 47,70 L 64,66 L 79,60 C 85,58 88,65 82,68 L 60,78 L 40,77 L 24,73 Z"
                                          Fill="{DynamicResource ThemeInputBackground}" Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" StrokeLineJoin="Round" />
                                    <Path Data="M 15,58 L 24,58 L 24,77 L 15,77 Z M 18,67 L 21,67"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="3" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Prestamo" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>

                    <!-- Exportar -->
                    <Button x:Name="ExportButton" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Exportar" Click="Exportar_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox Width="108" Height="100" Stretch="Uniform">
                                <Canvas Width="100" Height="90">
                                    <Path Data="M 32,42 L 32,19 M 20,31 L 32,19 L 44,31 M 32,19 L 32,52 M 68,48 L 68,71 M 56,59 L 68,71 L 80,59 M 68,71 L 68,38"
                                          Stroke="{DynamicResource ThemeTextForeground}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Path Data="M 53,15 L 53,29 M 47,22 L 53,15 L 59,22 M 47,67 L 53,74 L 59,67"
                                          Stroke="{DynamicResource ThemeAccent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <Border Height="1" Margin="12,12,12,10" Background="{DynamicResource ThemeBorder}" />
                            <TextBlock Text="Exportar" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- 3. Modal Overlay de Exportar -->
                <Grid x:Name="ExportarOverlay"
                      Grid.RowSpan="2"
                      Background="#66000000"
                      Visibility="Collapsed"
                      Focusable="True"
                      Panel.ZIndex="10"
                      MouseDown="ExportarOverlay_MouseDown"
                      PreviewKeyDown="ExportarOverlay_PreviewKeyDown">

                    <Border Width="780" Height="430"
                            MaxWidth="920"
                            Background="{DynamicResource ThemeSurfaceBackground}"
                            BorderBrush="{DynamicResource ThemeBorder}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Effect="{StaticResource AppleModalShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
