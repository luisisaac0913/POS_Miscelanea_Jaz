<UserControl x:Class="Punto_de_Venta.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="960" MinHeight="600"
        Background="Transparent"
        Focusable="True"
        IsVisibleChanged="UserControl_IsVisibleChanged"
        PreviewKeyDown="UserControl_PreviewKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Tokens complementarios -->
        <SolidColorBrush x:Key="SystemGreen" Color="#34C759" />

        <!-- Estilo Tarjetas Adaptable -->
        <Style x:Key="ConfigCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones Menu Lateral iPadOS -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cajas de Texto Adaptables -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton Guardar Azul Apple -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Eliminado el Border con fondo, bordes y redondeo de la ventana flotante -->
    <Grid Margin="24,10,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Título interno de la sección -->
        <TextBlock Grid.Row="0" Text="Configuracion" FontFamily="Segoe UI Variable, Segoe UI, -apple-system" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,16" />

        <!-- Contenido Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 1. Menu Lateral iPadOS -->
            <Border Grid.Column="0" Style="{StaticResource ConfigCardStyle}" Padding="12,14">
                <StackPanel>
                    <TextBlock Text="AJUSTES" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="8,0,0,10" />
                    <Button x:Name="NavImpresionBtn" Content="🖨️  Impresión" Style="{StaticResource SidebarButtonStyle}" Click="NavImpresion_Click" />
                    <Button x:Name="NavPersonalizacionBtn" Content="🎨  Personalización" Style="{StaticResource SidebarButtonStyle}" Click="NavPersonalizacion_Click" />
                    <Button x:Name="NavBasculaBtn" Content="⚖️  Báscula digital" Style="{StaticResource SidebarButtonStyle}" Click="NavBascula_Click" />
                    <Button x:Name="NavWhatsAppBtn" Content="📱  WhatsApp" Style="{StaticResource SidebarButtonStyle}" Click="NavWhatsApp_Click" />
                    <Button x:Name="NavSeguridadBtn" Content="🔒  Caja y Seguridad" Style="{StaticResource SidebarButtonStyle}" Click="NavSeguridad_Click" />
                    <Button x:Name="NavAtajosBtn" Content="⌨️  Atajos de teclado" Style="{StaticResource SidebarButtonStyle}" Click="NavAtajos_Click" />
                </StackPanel>
            </Border>

            <!-- 2. Formulario Central Dinámico -->
            <Border Grid.Column="2" Style="{StaticResource ConfigCardStyle}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>

                            <!-- ================= SECCIÓN 1: IMPRESIÓN ================= -->
                            <StackPanel x:Name="PanelImpresion" Visibility="Visible">
                                <TextBlock Text="Impresora" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <TextBlock Text="Impresora destino" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <ComboBox x:Name="PrintersComboBox" Height="38" Margin="0,0,0,10" VerticalContentAlignment="Center" FontSize="13" />

                                <TextBlock Text="Ancho de papel" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <ComboBox x:Name="PaperWidthComboBox" Height="38" Margin="0,0,0,12" VerticalContentAlignment="Center" FontSize="13" SelectionChanged="PaperWidthComboBox_SelectionChanged">
                                    <ComboBoxItem Content="58 mm estándar (32 columnas)" IsSelected="True" Tag="32" />
                                    <ComboBoxItem Content="80 mm ancho (42 columnas)" Tag="42" />
                                </ComboBox>

                                <!-- Opciones de comportamiento de ticket -->
                                <CheckBox x:Name="AskBeforePrintCheckBox" Content="Preguntar antes de imprimir al finalizar venta" Foreground="{DynamicResource ThemeTextForeground}" FontSize="13" Margin="0,0,0,6" Checked="AskBeforePrintCheckBox_Checked" />
                                <CheckBox x:Name="AutoPrintCheckBox" Content="Imprimir ticket siempre de forma automática" Foreground="{DynamicResource ThemeTextForeground}" FontSize="13" Margin="0,0,0,6" Checked="AutoPrintCheckBox_Checked" />
                                <CheckBox x:Name="NoPrintOrSaveCheckBox" Content="No guardar copia digital ni imprimir" Foreground="{DynamicResource ThemeTextForeground}" FontSize="13" Margin="0,0,0,12" Checked="NoPrintOrSaveCheckBox_Checked" />

                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,4,0,12" />
                                <TextBlock Text="Datos del ticket" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <TextBlock Text="Nombre del negocio" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessNameBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="Subtítulo / Giro" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessSubtitleBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="Dirección" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="BusinessAddressBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" TextChanged="TicketField_TextChanged" />

                                <TextBlock Text="Mensaje al pie del ticket" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="FooterMessageBox" Style="{StaticResource FormTextBoxStyle}" Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,6" Margin="0,0,0,12" TextChanged="TicketField_TextChanged" />
                            </StackPanel>

                            <!-- ================= SECCIÓN 2: PERSONALIZACIÓN ================= -->
                            <StackPanel x:Name="PanelPersonalizacion" Visibility="Collapsed">
                                <TextBlock Text="Apariencia y Tema" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <!-- MODO OSCURO -->
                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo oscuro" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Atenúa la interfaz para trabajar con poca luz (se aplica al guardar)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="DarkModeCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- MODO PREDETERMINADO DE BÁSCULA -->
                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo de báscula (F8)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Elige cómo se abre la ventana de pesaje por defecto" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="CmbModoBascula" Grid.Column="1" Width="150" VerticalAlignment="Center" SelectionChanged="CmbModoBascula_SelectionChanged">
                                            <ComboBoxItem Content="Por Peso (kg)" />
                                            <ComboBoxItem Content="Por Precio ($)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- ================= COLOR DE ACENTO ================= -->
                                <TextBlock Text="Color de Acento" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,24,0,4" />
                                <TextBlock Text="Elige el color principal para los botones, selecciones y resaltados del sistema." FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal">
                                    <!-- Azul iOS -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#007AFF" Click="ColorButton_Click" ToolTip="Azul Clásico">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#007AFF" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Verde Esmeralda -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#10B981" Click="ColorButton_Click" ToolTip="Verde Esmeralda">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#10B981" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Morado Neón -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#8B5CF6" Click="ColorButton_Click" ToolTip="Morado Neón">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#8B5CF6" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Naranja Vibrante -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#F97316" Click="ColorButton_Click" ToolTip="Naranja Vibrante">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#F97316" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Rojo Carmesí -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#E11D48" Click="ColorButton_Click" ToolTip="Rojo Carmesí">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#E11D48" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Rosa Hot Pink -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#EC4899" Click="ColorButton_Click" ToolTip="Rosa">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#EC4899" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Gris Oscuro -->
                                    <Button Width="36" Height="36" Margin="0,0,12,0" Cursor="Hand" Tag="#3F3F46" Click="ColorButton_Click" ToolTip="Gris Elegante">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#3F3F46" CornerRadius="18" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- ================= SECCIÓN 3: BÁSCULA DIGITAL ================= -->
                            <StackPanel x:Name="PanelBascula" Visibility="Collapsed">
                                <TextBlock Text="Báscula Digital (Puerto Serie RS-232)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="Permite pesar artículos a granel automáticamente desde la pantalla de cobro." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,12" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Habilitar báscula en el sistema" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Activa la lectura de peso al escanear o presionar F8 en cobro" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="EnableScaleCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="Puerto de conexión (COM)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ScalePortComboBox" Height="38" VerticalContentAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="2" Content="🔄 Detectar" Height="38" Padding="12,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Click="RefreshScalePorts_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Velocidad (Baud Rate)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                        <ComboBox x:Name="ScaleBaudRateComboBox" Height="38" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="9600 (Estándar Torrey / Rhino)" IsSelected="True" Tag="9600" />
                                            <ComboBoxItem Content="2400 (Básculas clásicas)" Tag="2400" />
                                            <ComboBoxItem Content="4800" Tag="4800" />
                                            <ComboBoxItem Content="19200" Tag="19200" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Protocolo de lectura" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                        <ComboBox x:Name="ScaleProtocolComboBox" Height="38" VerticalContentAlignment="Center" FontSize="13">
                                            <ComboBoxItem Content="Torrey / Rhino (Petición P)" IsSelected="True" />
                                            <ComboBoxItem Content="Modo Continuo" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Prueba de lectura en tiempo real" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock x:Name="ScaleTestResultText" Text="Coloca un objeto sobre la báscula y presiona probar" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Probar Báscula" Height="36" Padding="16,0" Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="TestScale_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ================= SECCIÓN: RECORDATORIOS WHATSAPP ================= -->
                            <StackPanel x:Name="PanelWhatsApp" Visibility="Collapsed">
                                <TextBlock Text="Recordatorios de Cobro por WhatsApp" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="Personaliza el mensaje que se enviará a los clientes con saldo pendiente." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,14" />

                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Variables disponibles para el mensaje:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,6" />
                                        <TextBlock Text="{}{CLIENTE} : Nombre del deudor" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                        <TextBlock Text="{}{SALDO} : Saldo que debe actualmente" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                        <TextBlock Text="{}{CONCEPTO} : Lo que se llevó fiado" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                        <TextBlock Text="{}{NEGOCIO} : Nombre de tu tienda" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Plantilla del mensaje" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <TextBox x:Name="WhatsAppTemplateBox" Style="{StaticResource FormTextBoxStyle}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,6" Margin="0,0,0,14" />
                            </StackPanel>

                            <!-- ================= SECCIÓN 4: CAJA Y SEGURIDAD ================= -->
                            <StackPanel x:Name="PanelSeguridad" Visibility="Collapsed">
                                <TextBlock Text="Seguridad de acceso" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />

                                <!-- NUEVO: Activar / Desactivar PIN de Administrador -->
                                <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Solicitar PIN de administrador" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Pedir contraseña al abrir Configuración, Cortes de Caja e Inventario." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="RequirePinCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="Cambiar PIN de administrador (mínimo 4 dígitos)" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,4" />
                                <PasswordBox x:Name="NewPinBox" 
                                             Height="38" 
                                             Background="{DynamicResource ThemeInputBackground}" 
                                             Foreground="{DynamicResource ThemeTextForeground}" 
                                             BorderBrush="{DynamicResource ThemeBorder}" 
                                             BorderThickness="1" 
                                             Padding="10,0" 
                                             VerticalContentAlignment="Center" 
                                             FontSize="14" 
                                             Margin="0,0,0,14" />

                                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,8,0,12" />
                                <TextBlock Text="Copias de Seguridad (Respaldos)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,6" />
                                <TextBlock Text="Ubicación donde se guardarán los archivos comprimidos .ZIP:" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0,0,6" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupFolderBox" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" ToolTip="Ruta de almacenamiento de respaldos" />
                                    <Button Grid.Column="2" Content="Examinar..." Height="38" Padding="14,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" FontFamily="Segoe UI Variable, Segoe UI" FontWeight="SemiBold" Cursor="Hand" Click="BrowseBackupFolder_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- ================= SECCIÓN 5: ATAJOS DE TECLADO ================= -->
                            <StackPanel x:Name="PanelAtajos" Visibility="Collapsed">
                                <TextBlock Text="Guía de Atajos Rápidos" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,4" />
                                <TextBlock Text="Usa estas combinaciones para operar el punto de venta a máxima velocidad." FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,14" />

                                <!-- 1. PANTALLA DE COBRO -->
                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PANTALLA DE COBRO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <Grid Margin="0,3">
                                            <TextBlock Text="Buscar producto en caja" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Ctrl + ←  /  Tab" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Añadir producto / Seleccionar sugerencia" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Enter" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Navegar lista de sugerencias" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="↑  /  ↓" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Abrir modal de pesaje en báscula" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F8" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Abrir cajón de dinero manualmente" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F5" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Movimientos de caja (Entradas / Gastos / Fondo)" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F4" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Abrir ventana de cobro / liquidar" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Shift + Enter" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Quitar producto seleccionado del carrito" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Backspace" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 2. VENTANA DE COBRO / MODAL DE PAGO -->
                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="MODAL DE PAGO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <Grid Margin="0,3">
                                            <TextBlock Text="Método de pago: Efectivo" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F1" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Método de pago: Tarjeta" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F2" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Método de pago: Transferencia" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F3" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Fiar venta / Registrar préstamo a cliente" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F6" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Confirmar y finalizar venta" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Enter" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 3. INVENTARIO -->
                                <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="INVENTARIO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,0,8" />

                                        <Grid Margin="0,3">
                                            <TextBlock Text="Ir directo al buscador de productos" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Ctrl + F" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Avanzar campos del formulario / Guardar producto" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="Enter" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,5,0,3">
                                            <TextBlock Text="Imprimir etiqueta con código de barras" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="F9" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Acción Guardar -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <Button Content="Guardar cambios" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="SaveConfig_Click" />
                        <TextBlock x:Name="StatusMessage" Text="" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Derecha: Vista Previa del Ticket -->
            <Border x:Name="PreviewCardBorder" Grid.Column="4" Style="{StaticResource ConfigCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Vista previa del ticket" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,10" />
                    <Border Grid.Row="1" Background="#FAF9F6" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewTicketText" FontFamily="Consolas, Lucida Console, Courier New" FontSize="11" Foreground="#1C1C1E" TextWrapping="NoWrap" LineHeight="16" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>