<UserControl x:Class="Punto_de_Venta.Graficas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="760"
             MinWidth="1040" MinHeight="660"
             Background="Transparent"
             Focusable="True"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Loaded="UserControl_Loaded"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Tokens complementarios -->
        <SolidColorBrush x:Key="SystemGreen" Color="#34C759" />

        <!-- Sombras Apple -->
        <DropShadowEffect x:Key="AppleCardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
        <DropShadowEffect x:Key="AppleModalShadow" BlurRadius="36" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.25" />

        <!-- Estilo Tarjeta Contenedora -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect" Value="{StaticResource AppleCardShadow}" />
        </Style>

        <!-- Botones Segmentados de Periodo -->
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones del Menu Lateral iPadOS -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <!-- Eliminado el Border exterior tipo ventana con bordes y fondo oscuro -->
    <Border Background="Transparent" ClipToBounds="True">
        <Grid>
            <!-- Contenido Principal -->
            <Grid Margin="32,20,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Encabezado + Filtro de Periodo + Botón Ayuda + Reloj -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Nuevo Título Interno (Reemplaza a la vieja barra de ventana) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Gráficas y Reportes" FontFamily="Segoe UI Variable, Segoe UI, -apple-system" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                        <TextBlock Text="Presiona ESC para volver" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnExportarPdf" 
                                Width="220" Height="40" 
                                HorizontalAlignment="Right" 
                                Margin="10,0,20,0"
                                Cursor="Hand"
                                Click="ExportarReporteDia_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1597a7" 
                                            CornerRadius="8" 
                                            BorderThickness="0">
                                        <TextBlock Text="📥Exportar a PDF" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- CONTENEDOR DE PERIODOS -->
                        <Grid VerticalAlignment="Center">
                            <!-- Selector de Periodo iOS -->
                            <Border x:Name="NormalPeriodContainer" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="11" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DayButton" Content="   Hoy   " Style="{StaticResource SegmentButtonStyle}" Click="DayButton_Click" />
                                    <Button x:Name="WeekButton" Content="  Semana " Style="{StaticResource SegmentButtonStyle}" Click="WeekButton_Click" />
                                    <Button x:Name="MonthButton" Content="   Mes   " Style="{StaticResource SegmentButtonStyle}" Click="MonthButton_Click" />
                                    <Button x:Name="YearButton" Content="   Año   " Style="{StaticResource SegmentButtonStyle}" Click="YearButton_Click" />
                                    <Button x:Name="CustomButton" Content="  Rango  " Style="{StaticResource SegmentButtonStyle}" Click="CustomButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Selector Custom -->
                            <Border x:Name="CustomPeriodContainer" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="11" Padding="3" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <DatePicker x:Name="StartDatePicker" Width="105" Margin="4,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextForeground}" />
                                    <TextBlock Text="a" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedForeground}" Margin="2,0" />
                                    <DatePicker x:Name="EndDatePicker" Width="105" Margin="4,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextForeground}" />

                                    <Button Content="Aplicar" Margin="4,0,0,0" Padding="10,0" Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="ApplyCustomDate_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="✕" Margin="4,0" Padding="8,0" Background="Transparent" Foreground="{DynamicResource ThemeTextForeground}" BorderThickness="0" Cursor="Hand" Click="CancelCustomDate_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Botón de Ayuda -->
                        <Button Content="Ayuda" Height="36" Padding="14,0" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Cursor="Hand" Margin="10,0,10,0" Click="HelpButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Reloj -->
                        <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Text="12:00 PM" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. Tarjetas KPI de Resumen Financiero -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="VENTA TOTAL" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="KpiVentaTotal" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,4,0,2" />
                            <TextBlock x:Name="KpiTransacciones" Text="0 ventas" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="COSTO (INVERSION)" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="KpiCostoTotal" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,2" />
                            <TextBlock Text="Mercancia vendida" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="GANANCIA BRUTA" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="KpiGananciaNeta" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SystemGreen}" Margin="0,4,0,2" />
                            <TextBlock x:Name="KpiMargenPorcentaje" Text="Margen: 0%" FontSize="12" Foreground="{StaticResource SystemGreen}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="GASTOS DE CAJA" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="KpiGastosTotal" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,2" />
                            <TextBlock Text="Retiros y salidas" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="BALANCE NETO" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="KpiBalanceNeto" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,2" />
                            <TextBlock x:Name="KpiTicketPromedio" Text="Ticket: $0.00" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="10" Style="{StaticResource CardStyle}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="GANANCIA ESPERADA" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="InversionTotal" Text="$0.00" FontFamily="Segoe UI Variable, Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ThemeTextForeground}" Margin="0,4,0,2" />
                            <TextBlock x:Name="InversionTotalProductos" Text="Mercancia surtida" FontSize="12" Foreground="{StaticResource ThemeTextForeground}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Contenido Principal: Barra Lateral + Gráficas / Tablas + Top Productos -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <!-- Menú Lateral -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12,14">
                        <StackPanel>
                            <TextBlock Text="VISTAS" FontFamily="Segoe UI Variable, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" Margin="8,0,0,10" />
                            <Button x:Name="NavFinanzasBtn" Content="📊  Finanzas" Style="{StaticResource SidebarButtonStyle}" Click="NavFinanzas_Click" />
                            <Button x:Name="NavMetodosBtn" Content="💳  Métodos de Pago" Style="{StaticResource SidebarButtonStyle}" Click="NavMetodos_Click" />
                            <Button x:Name="NavCategoriasBtn" Content="🏷 Categorías" Style="{StaticResource SidebarButtonStyle}" Click="NavCategorias_Click" />
                            <Button x:Name="NavHorasBtn" Content="⏰  Horas Pico" Style="{StaticResource SidebarButtonStyle}" Click="NavHorasBtn_Click" />
                            <Button x:Name="NavRentabilidadBtn" Content="💎  Rentabilidad Top" Style="{StaticResource SidebarButtonStyle}" Click="NavRentabilidadBtn_Click" />
                            <Button x:Name="NavCortesBtn" Content="🧾  Cortes de Caja" Style="{StaticResource SidebarButtonStyle}" Click="NavCortesBtn_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Área Central -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ChartTitleText" Text="VS" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,12" />

                            <lvc:CartesianChart x:Name="MainChartView" Grid.Row="1" Series="{Binding SeriesPrincipal}" XAxes="{Binding EjesXPrincipal}" YAxes="{Binding EjesYPrincipal}" />
                            <lvc:PieChart x:Name="PieChartView" Grid.Row="1" Series="{Binding SeriesPie}" Visibility="Collapsed" LegendPosition="Right" />

                            <Grid x:Name="CortesContainerView" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fecha y Hora" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" />
                                        <TextBlock Grid.Column="1" Text="Esperado" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="Contado" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="3" Text="Diferencia" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeMutedForeground}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding CortesAuditoria}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorder}" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="CorteItem_MouseDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FechaHoraFormateada}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" />
                                                            <TextBlock Text="{Binding FolioTexto}" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding EsperadoFormateado}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ContadoFormateado}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                                        <Border Grid.Column="3" Background="{Binding BadgeBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DiferenciaFormateada}" FontSize="12" FontWeight="Bold" Foreground="{Binding BadgeForeground}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Top Productos -->
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TopListTitleText" Text="Top Productos Vendidos" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,12" />

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProductos}" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,9" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Posicion}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                    <TextBlock Text="{Binding Nombre}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Cantidad, StringFormat={}{0} piezas}" FontSize="11" Foreground="{DynamicResource ThemeMutedForeground}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Ingreso, StringFormat={}{0:C2}}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Modal Guía de Ayuda Rápida -->
                <Grid x:Name="HelpOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="#66000000" Visibility="Collapsed" MouseDown="HelpOverlay_MouseDown">
                    <Border Width="640" MaxHeight="600" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="26" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource AppleModalShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Guía de Métricas" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,10,0">
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Venta Total" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Importe bruto cobrado por todos los métodos de pago disponibles." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Costo" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Costo de adquisición de la mercancía vendida (inversión de reposición)." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Ganancia Bruta" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SystemGreen}" />
                                            <TextBlock Text="Utilidad generada antes de descontar los gastos operativos de caja." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Gastos de Caja" FontWeight="Bold" FontSize="14" Foreground="#EF4444" />
                                            <TextBlock Text="Retiros registrados en el turno para compras menores, servicios o pagos a proveedores." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Horas Pico" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeAccent}" />
                                            <TextBlock Text="Distribución horaria que muestra a qué horas del día se concentra el mayor volumen de clientes para reforzar la atención en mostrador." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Ganancia esperada" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="La suma de la multiplicacio de la ganancia por la cantidad de stock disponible de cada producto." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource ThemeInputBackground}" CornerRadius="14" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="Rentabilidad Top" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTextForeground}" />
                                            <TextBlock Text="Ranking de artículos ordenados por dinero neto que dejan a la caja, no solo por piezas vendidas." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="4" Content="¡Entendido!" Height="42" Background="{DynamicResource ThemeAccent}" Foreground="White" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="CloseHelp_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MODAL: HISTORIAL DE MOVIMIENTOS -->
                <Grid x:Name="MovimientosOverlay" Grid.RowSpan="3" Panel.ZIndex="999" Background="#66000000" Visibility="Collapsed">
                    <Border Width="550" MaxHeight="500" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="18" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource AppleModalShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="MovimientosModalTitle" Text="Movimientos del Turno" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,16" />

                            <Border Grid.Row="1" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="12,12,4,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hora" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                        <TextBlock Grid.Column="1" Text="Tipo" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                        <TextBlock Grid.Column="2" Text="Concepto" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                                        <TextBlock Grid.Column="3" Text="Monto" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                                        <ItemsControl x:Name="MovimientosTurnoGrid">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorder}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding FechaHora, StringFormat=t}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Tipo}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Concepto}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Monto, StringFormat=C2}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Button Grid.Row="2" Content="Cerrar (Esc)" Height="42" Width="140" HorizontalAlignment="Right" Margin="0,16,0,0" Foreground="{DynamicResource ThemeTextForeground}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="CloseMovimientosOverlay_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>