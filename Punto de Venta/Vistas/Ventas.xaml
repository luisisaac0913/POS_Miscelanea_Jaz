<UserControl x:Class="Punto_de_Venta.Ventas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="1000" MinHeight="640"
        Background="Transparent"
        Focusable="True"
        IsVisibleChanged="UserControl_IsVisibleChanged"
        PreviewKeyDown="UserControl_PreviewKeyDown"
        Loaded="UserControl_Loaded"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <DropShadowEffect x:Key="AppleCardShadow" BlurRadius="24" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04" />
        <DropShadowEffect x:Key="AppleButtonShadow" BlurRadius="12" ShadowDepth="3" Direction="270" Color="#007AFF" Opacity="0.22" />

        <Style x:Key="AppleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Effect" Value="{StaticResource AppleCardShadow}" />
        </Style>

        <Style x:Key="PeriodSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones secundarios redondeados -->
        <Style x:Key="ApplePillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppleDangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#FECACA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#FCA5A5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerBorder" Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplePrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, -apple-system" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Effect" Value="{StaticResource AppleButtonShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{DynamicResource ThemeBorder}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" ClipToBounds="True">
        <Grid Margin="32,20,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Source="/Imagenes/Logo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="450" Opacity="0.12" IsHitTestVisible="False" Panel.ZIndex="0" Grid.RowSpan="4" />

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Ventas" FontFamily="Segoe UI Variable, Segoe UI, -apple-system" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Exportar -->
                    <Button Content="📥 Exportar Excel (F8)" Style="{StaticResource ApplePillButtonStyle}" Margin="0,0,12,0" Height="36" Padding="12,0" Foreground="{DynamicResource ThemeAccent}" Click="ExportButton_Click" ToolTip="Descargar historial filtrado en archivo Excel/CSV" />

                    <Border Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnPeriodoDia" Content="Día" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Dia" />
                            <Button x:Name="BtnPeriodoSemana" Content="Semana" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Semana" />
                            <Button x:Name="BtnPeriodoMes" Content="Mes" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Mes" />
                            <Button x:Name="BtnPeriodoCustom" Content="Personalizado" Style="{StaticResource PeriodSegmentButtonStyle}" Click="BtnPeriodo_Click" Tag="Custom" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="CustomDatePanel" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <DatePicker x:Name="DatePickerDesde" Height="36" Width="120" VerticalContentAlignment="Center" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                        <TextBlock Text="al" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource ThemeMutedForeground}" FontSize="12" />
                        <DatePicker x:Name="DatePickerHasta" Height="36" Width="120" VerticalContentAlignment="Center" SelectedDateChanged="DatePicker_SelectedDateChanged" />
                    </StackPanel>

                    <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="6:08 PM" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextForeground}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Buscador -->
            <Border Grid.Row="1" Height="44" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" Foreground="{DynamicResource ThemeTextForeground}" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Buscar venta por ID, fecha o productos" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Buscar venta por ID, producto o fecha (ej. 24/10/2026)..." FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" Foreground="{DynamicResource ThemeMutedForeground}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Tabla de Ventas -->
            <Border Grid.Row="2" Style="{StaticResource AppleCardStyle}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="SalesGrid" ItemsSource="{Binding SalesView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ThemeBorder}" BorderThickness="0" Background="Transparent" SelectionUnit="FullRow" SelectionMode="Single" SelectionChanged="SalesGrid_SelectionChanged" MouseDoubleClick="SalesGrid_MouseDoubleClick" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" RowHeight="54" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForeground}" />
                            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="12,12" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextForeground}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ThemeInputBackground}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                    <Setter Property="Background" Value="#F0FDF4" />
                                    <Setter Property="Foreground" Value="#166534" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="Cancelada">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Estado}" Value="Fiado">
                                    <Setter Property="Background" Value="#FFFBEB" />
                                    <Setter Property="Foreground" Value="#92400E" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F1FF" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ESTADO" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBadge" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" BorderThickness="1" Background="#15007AFF" BorderBrush="#30007AFF">
                                        <TextBlock x:Name="StatusText" Text="{Binding Estado}" FontSize="11" FontWeight="Bold" Foreground="#007AFF" HorizontalAlignment="Center" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="Cerrada">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#152ECC71" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#402ECC71" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#2ECC71" />
                                            <Setter TargetName="StatusText" Property="Text" Value="Cerrada" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Abierta">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#15007AFF" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#40007AFF" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#007AFF" />
                                            <Setter TargetName="StatusText" Property="Text" Value="Abierta" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Fiado">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#15F39C12" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#40F39C12" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#F39C12" />
                                            <Setter TargetName="StatusText" Property="Text" Value="Fiado" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="MÉTODO" Binding="{Binding MetodoPago}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRODUCTOS" Binding="{Binding ProductosResumen}" Width="2.1*" />
                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadTotal}" Width="0.65*" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat={}{0:C2}}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding FechaHora, StringFormat={}{0:dd/MM/yyyy hh:mm tt}}" Width="1.35*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 3. Dashboard Inferior y Botones de Acción -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Izquierda: Dashboard de Métricas -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="16,10" Effect="{StaticResource AppleCardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Ventas -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="Ventas Brutas" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="TotalSalesTodayText" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeBorder}" Margin="5,5" />

                        <!-- Ganancia -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="Ganancia Neta" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="TotalProfitText" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#10B981" />
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Background="{DynamicResource ThemeBorder}" Margin="5,5" />

                        <!-- Artículos -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="Art. Vendidos" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="TotalProductsSoldText" Text="0 pzas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                        </StackPanel>

                        <Border Grid.Column="5" Width="1" Background="{DynamicResource ThemeBorder}" Margin="5,5" />

                        <!-- Gastos -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="Salidas / Gastos" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="MetricGastosText" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#EF4444" />
                        </StackPanel>

                        <Border Grid.Column="7" Width="1" Background="{DynamicResource ThemeBorder}" Margin="5,5" />

                        <!-- Balance Total -->
                        <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="Balance en Caja" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" />
                            <TextBlock x:Name="MetricBalanceText" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Derecha: Botones de Acción Operativa -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🖨️ REIMPRIMIR (F7)" Style="{StaticResource ApplePillButtonStyle}" Margin="0,0,10,0" Height="52" Padding="14,0" IsEnabled="{Binding ElementName=ReturnButton, Path=IsEnabled}" Click="ReprintTicketButton_Click" ToolTip="Imprimir copia del ticket de la venta seleccionada" />
                    <Button Content="📄 DETALLES" Style="{StaticResource ApplePillButtonStyle}" Margin="0,0,10,0" Height="52" Padding="14,0" IsEnabled="{Binding ElementName=ReturnButton, Path=IsEnabled}" Click="ViewDetailsButton_Click" ToolTip="Ver qué se vendió (Doble clic en la tabla)" />
                    <Button x:Name="ReturnButton" Content="DEVOLUCIÓN" Style="{StaticResource AppleDangerButtonStyle}" MinWidth="130" Margin="0,0,10,0" IsEnabled="False" Click="ReturnButton_Click" ToolTip="Cancelar venta y retornar mercancía" />
                    <Button Content="CERRAR CAJA" Style="{StaticResource ApplePrimaryActionButtonStyle}" MinWidth="150" Click="CashCloseButton_Click" ToolTip="Hacer corte ciego de caja" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>