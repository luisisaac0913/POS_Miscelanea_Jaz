<Window x:Class="Punto_de_Venta.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">

    <Border x:Name="ToastContainer" 
            CornerRadius="18" 
            Padding="16,10" 
            Margin="12"
            BorderThickness="1"
            Background="{DynamicResource ThemeSurfaceBackground}"
            BorderBrush="{DynamicResource ThemeBorder}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.18" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Icono de estado -->
            <TextBlock x:Name="IconText" 
                       Text="✓" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,10,0" 
                       VerticalAlignment="Center" />

            <!-- Mensaje -->
            <TextBlock x:Name="MessageText" 
                       Text="Operación completada" 
                       FontFamily="Segoe UI Variable, Segoe UI, -apple-system" 
                       FontSize="13" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource ThemeTextForeground}" 
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>