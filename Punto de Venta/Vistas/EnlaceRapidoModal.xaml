<Window x:Class="Punto_de_Venta.Vistas.EnlaceRapidoModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="🔗 Enlace Rápido de Códigos" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextForeground}" Margin="0,0,0,15" />

            <StackPanel Grid.Row="1">
                <TextBlock Text="1. Escanea el código físico" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtCodigo" Height="38" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" KeyDown="TxtCodigo_KeyDown" />

                <TextBlock Text="2. Busca y selecciona el producto" FontSize="12" Foreground="{DynamicResource ThemeMutedForeground}" Margin="0,15,0,4" />
                <TextBox x:Name="TxtBusqueda" Height="38" FontSize="14" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource ThemeInputBackground}" Foreground="{DynamicResource ThemeTextForeground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" TextChanged="TxtBusqueda_TextChanged" KeyDown="TxtBusqueda_KeyDown" />

                <!-- Lista de Sugerencias Flotante -->
                <Border x:Name="PopupSugerencias" Background="{DynamicResource ThemeSurfaceBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Visibility="Collapsed" MaxHeight="120">
                    <ListBox x:Name="ListaSugerencias" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextForeground}" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="ListaSugerencias_SelectionChanged" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Cancelar" Width="90" Height="36" Margin="0,0,10,0" Background="Transparent" Foreground="{DynamicResource ThemeTextForeground}" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click" />
                <Button Content="Enlazar" Width="100" Height="36" Background="{DynamicResource ThemeAccent}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnEnlazar_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>